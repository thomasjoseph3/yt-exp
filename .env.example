# Copy to .env and fill in what you have. Everything is optional except one LLM.

# Qoder CLI sign-in for the 24/7 service (qoder.com/account/integrations)
QODER_PERSONAL_ACCESS_TOKEN=

# Claude backup writer inside Docker: run `claude setup-token` on any machine and paste the token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional second voice: Google Cloud Chirp 3 HD (needs a billing card; capped below the free 1M chars/month).
GOOGLE_TTS_API_KEY=

# Thoma's voice (Gemini TTS, free tier). Not used for writing scripts.
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (free, no card)
GEMINI_API_KEY_2=        # optional backup key, used when the first is rate-limited or revoked

# YouTube: an API key is only for reading (idea backfill). Uploading uses OAuth:
# put the Desktop OAuth client JSON at ~/.config/thoma-studio/youtube_client.json
# and run `thoma auth-youtube` once.
YOUTUBE_API_KEY=

# Meta (Facebook Page + Instagram professional account linked to it)
META_PAGE_ID=
META_PAGE_TOKEN=         # long-lived Page access token
META_IG_USER_ID=         # Instagram business/creator account ID

# Phone notifications (optional): create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
